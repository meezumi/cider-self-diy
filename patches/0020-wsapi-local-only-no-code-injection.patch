 const ws = require("ws");
 const electron = require("electron");
 const WebSocketServer = ws.Server;
+// Values from a client's message reach the renderer as JSON literals, never
+// spliced into code. They used to be pasted between backticks or quotes, so a
+// search term containing one ended the string and ran whatever followed.
+// String(value) is what the template literal produced, so callers see the
+// same values as before.
+const jsString = (value) => JSON.stringify(String(value));
+const jsNumber = (value) => String(Number(value));
+const jsBool = (value) => String(value === true || value === "true");
+// The server is bound to localhost, but a browser will open a WebSocket to
+// localhost from any page, and always says which page in Origin. Clients that
+// are not browsers -- the webNowPlaying plugin, scripts, remote apps -- send
+// no Origin; pages served from this machine keep working.
+const isLocalOrigin = (origin) => {
+    if (!origin) {
+        return true;
+    }
+    try {
+        return ["localhost", "127.0.0.1", "[::1]"].includes(new URL(origin).hostname);
+    }
+    catch (e) {
+        return false;
+    }
+};
